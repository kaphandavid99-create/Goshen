# Application
NEXT_PUBLIC_APP_URL="http://localhost:3005"
NODE_ENV="development"

# Supabase Postgres (Project Settings > Database > Connection string). Same values on Vercel.
# DATABASE_URL = Transaction pooler (6543). Keep ?pgbouncer=true AND an explicit connection_limit
#   (without it Prisma pins the pool to 1 and the admin dashboard's parallel queries time out).
#   The 5432 session pooler is NOT usable here — it caps at 15 clients ("max clients reached").
# DIRECT_URL = Session pooler (5432), used only by prisma migrate / studio.
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20"
DIRECT_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Custom authentication / sessions
# Generate long random strings before running locally.
SESSION_SECRET="replace-with-a-long-random-string"
SESSION_COOKIE_NAME="goshen_session"
SESSION_MAX_AGE_SECONDS="1209600"

# CSRF protection
CSRF_SECRET="replace-with-a-long-random-string"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Google sign-in (Google Cloud OAuth client, redirect: {APP_URL}/api/auth/google/callback)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Shop assistant chatbot (Groq — free API key at console.groq.com/keys).
# Without a key the assistant still answers common questions via the built-in rules engine.
GROQ_API_KEY=""
# ASSISTANT_MODEL="openai/gpt-oss-120b"   # or openai/gpt-oss-20b (lighter, uses less daily quota)

# Web Push notifications (VAPID). Generate with: npx web-push generate-vapid-keys --json
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hello@example.com"

# MTN MoMo Collections API (momodeveloper.mtn.com). Sandbox needs only the
# subscription key — the provisioning script mints the API user + key.
MOMO_ENV="sandbox"
MOMO_BASE_URL="https://sandbox.momodeveloper.mtn.com"
MOMO_TARGET_ENVIRONMENT="sandbox"
MOMO_COLLECTION_SUBSCRIPTION_KEY=""
MOMO_COLLECTION_API_USER=""
MOMO_COLLECTION_API_KEY=""
# Sandbox rejects XAF — use EUR there. Production MTN Cameroon uses XAF.
MOMO_CURRENCY="EUR"
# Optional: public HTTPS URL MoMo calls with the final status.
MOMO_CALLBACK_URL=""
