# Application
NEXT_PUBLIC_APP_URL="http://localhost:3005"
NODE_ENV="development"

# MySQL (MySQL Workbench: localhost:3306, user root, schema goshen_provision)
DATABASE_URL="mysql://root:PASSWORD@localhost:3306/goshen_provision"

# Custom authentication / sessions
# Generate long random strings before running locally.
SESSION_SECRET="replace-with-a-long-random-string"
SESSION_COOKIE_NAME="goshen_session"
SESSION_MAX_AGE_SECONDS="1209600"

# CSRF protection
CSRF_SECRET="replace-with-a-long-random-string"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Google sign-in (Google Cloud OAuth client, redirect: {APP_URL}/api/auth/google/callback)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Shop assistant chatbot (Google Gemini API — free tier at aistudio.google.com/apikey).
GEMINI_API_KEY=""
# ASSISTANT_MODEL="gemini-2.5-flash"
